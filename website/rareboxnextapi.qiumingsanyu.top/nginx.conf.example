server {
    listen 80;
    server_name rareboxnextapi.qiumingsanyu.top;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name rareboxnextapi.qiumingsanyu.top;

    ssl_certificate     /etc/nginx/ssl/rareboxnextapi.qiumingsanyu.top/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/rareboxnextapi.qiumingsanyu.top/privkey.pem;

    root /var/www/rareboxnextapi.qiumingsanyu.top;
    index index.php;
    charset utf-8;
    server_tokens off;

    if ($request_method !~ ^(GET|HEAD|POST|OPTIONS)$) {
        return 405;
    }

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'" always;

    # Runtime data, PHP includes and the local dev router are never web-served.
    location ^~ /data/ { return 404; }
    location = /data { return 404; }
    location ^~ /lib/ { return 404; }
    location = /lib { return 404; }
    location = /config.php { return 404; }
    location ~* ^/(router\.php|config\.local\.php)$ { return 404; }
    location ^~ /.git/ { return 404; }
    location ~ /\.(?!well-known/) { deny all; }

    # admin/ PHP views may only be rendered by index.php.
    location ~* ^/admin/.*\.php$ { return 404; }

    # Throttle the login form only.
    location = /admin/login {
        limit_req zone=rarebox_login burst=5 nodelay;
        try_files $uri /index.php?$query_string;
    }

    location ~* \.(css|js|png|svg|ico|webp|woff2?)$ {
        expires 1h;
    }

    location / {
        try_files $uri /index.php?$query_string;
    }

    location ~* \.php$ {
        add_header Cache-Control "no-store" always;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";
        fastcgi_read_timeout 30s;
        fastcgi_hide_header X-Powered-By;
    }
}
